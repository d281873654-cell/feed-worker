{
  "name": "feed-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",

  "vars": {
    "LZHE_BASE_URL": "https://liuzhe.world"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  },

  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}